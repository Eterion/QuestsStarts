<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <ScrollFrame name="QuestsStartsScrollFrameTemplate" inherits="ScrollFrameTemplate" virtual="true">
        <KeyValues>
            <KeyValue key="scrollBarTemplate" value="MinimalScrollBar" type="string"/>
            <KeyValue key="scrollBarHideIfUnscrollable" value="true" type="boolean"/>
            <KeyValue key="scrollBarX" value="6" type="number"/>
            <KeyValue key="scrollBarTopY" value="0" type="number"/>
            <KeyValue key="scrollBarBottomY" value="0" type="number"/>
        </KeyValues>
    </ScrollFrame>
    <Frame name="QuestsStartsPickupPinTemplate" mixin="QuestsStartsPickupPinMixin" enableMouse="true" virtual="true">
        <Size x="22" y="22"/>
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="Texture" atlas="QuestNormal" setAllPoints="true"/>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="Collected" file="Interface\RaidFrame\ReadyCheck-Ready" hidden="true">
                    <Size x="13" y="13"/>
                    <Anchors><Anchor point="TOPRIGHT" x="4" y="3"/></Anchors>
                </Texture>
                <Texture parentKey="ItemBadge" hidden="true">
                    <Size x="12" y="12"/>
                    <Anchors><Anchor point="BOTTOMLEFT" x="-3" y="-2"/></Anchors>
                </Texture>
                <FontString parentKey="Count" inherits="GameFontNormalSmall" justifyH="RIGHT">
                    <Anchors><Anchor point="BOTTOMRIGHT" x="4" y="-2"/></Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>
    <Button name="QuestsStartsEntrancePinTemplate" mixin="QuestsStartsEntrancePinMixin" enableMouse="true" registerForClicks="LeftButtonUp" virtual="true">
        <Size x="24" y="24"/>
        <Layers>
            <Layer level="ARTWORK"><Texture parentKey="Texture" setAllPoints="true"/></Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="Glow" file="Interface\Minimap\Dungeon" alpha="0.6" alphaMode="ADD" setAllPoints="true" hidden="true"/>
            </Layer>
        </Layers>
    </Button>
</Ui>
